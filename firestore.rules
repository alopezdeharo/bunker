rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /items/{itemId} {
      allow read:  if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /comments/{commentId} {
      allow read:   if resource.data.hidden == false || isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.hidden == false;
      allow update,
      delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create,
      update: if isSignedIn()
              && request.resource.data.uid == request.auth.uid
              && ratingId == (request.resource.data.itemId + "_" + request.auth.uid)
              && request.resource.data.stars is int
              && request.resource.data.stars >= 1
              && request.resource.data.stars <= 5;
      allow delete: if isAdmin();
    }

  }
}
